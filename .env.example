# ==========================================
# CONFIGURACIÓN DEL LLM (Agent Harness)
# ==========================================
# Opciones soportadas por el Registry: openai, openrouter, groq, fake
# NOTA: en el código el default es `fake` (app/core/config.py), pero este ejemplo
# fija `openrouter` para que puedas usar un proveedor real nada más copiarlo.
LLM_PROVIDER=openrouter

# OpenRouter (Recomendado por su compatibilidad y soporte multimodal)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI (Directo)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Groq (Ultra rápido)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# CONFIGURACIÓN DE SEGURIDAD (Harness)
# ==========================================
# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Observabilidad con Langfuse (solo se activa si PUBLIC_KEY y SECRET_KEY están definidas)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# RUTAS CENTRALIZADAS
# ==========================================
# Raíz de todos los artefactos generados: memoria, sesiones, permisos, logs
# y caché de precios (por defecto `.harness`).
DATA_DIR=.harness

# ==========================================
# CONFIGURACIÓN DE MEMORIA
# ==========================================
# Backend para el almacenamiento de memoria:
#   - sqlite: Base de datos SQLite con búsqueda FTS5 (recomendado)
#   - files:  Archivos markdown individuales (legible por humanos)
#   - memory: Buffer en RAM (se pierde al reiniciar)
#   - fanout: Escribe en archivos Y en SQLite a la vez (redundancia)
#   - vector: Base de datos SQLite con búsqueda semántica (sqlite-vec + fastembed)
MEMORY_BACKEND=sqlite

# ==========================================
# CONFIGURACIÓN MCP (Opcional)
# ==========================================
# Si usas variables de entorno para servidores MCP externos, defínelas aquí.
# (La configuración principal de servidores está en mcp_config.json)

# ==========================================
# PROMPT CACHING
# ==========================================
# Activa el cacheo de prompts para ahorrar tokens (soportado en OpenAI y OpenRouter)
ENABLE_PROMPT_CACHING=true

# ==========================================
# LIMITS
# ==========================================
# Máximo de caracteres a extraer de un documento (PDF, DOCX, XLSX, PPTX).
# Un valor alto consume más tokens. 15000 chars ≈ 3750 tokens.
MAX_DOCUMENT_CHARS=15000

# ==========================================
# TIMEOUTS (segundos)
# ==========================================
# Tiempo máximo para un stream completo del LLM (TUI)
LLM_STREAM_TIMEOUT=300
# Timeout para ejecución de herramientas (bash, tools MCP, etc.)
TOOL_TIMEOUT=30
# Timeout para conectar a un servidor MCP
MCP_CONNECT_TIMEOUT=10

# ==========================================
# PRICING
# ==========================================
# Días de caché para los precios de la API (OpenRouter, etc.)
PRICING_CACHE_TTL_DAYS=1
# Ruta al archivo de configuración de proveedores
PRICING_CONFIG_FILE=pricing_config.json

# ==========================================
# AGENT-TO-AGENT (A2A)
# ==========================================
# Estrategia: supervisor | sequential | parallel | swarm
A2A_STRATEGY=supervisor

# Para sequential: orden de ejecución
A2A_SEQUENCE=analyst,writer,reviewer

# Para parallel: agentes a lanzar en paralelo
A2A_PARALLEL_AGENTS=analyst,reviewer

# Para swarm: agente inicial
A2A_SWARM_START=analyst

# ==========================================
# MODELOS POR AGENTE A2A
# ==========================================
# Si se deja vacío, usa el modelo por defecto del proveedor (OPENROUTER_MODEL)
# Analista: necesita razonamiento profundo (ej. gpt-4o, claude-3.5-sonnet)
A2A_ANALYST_MODEL=
# Escritor: prioriza velocidad y coste (ej. gpt-4o-mini, claude-3-haiku)
A2A_WRITER_MODEL=
# Revisor: necesita imparcialidad y criterio (ej. claude-3.5-sonnet)
# También se usa como modelo del crítico de auto-reflexión.
A2A_REVIEWER_MODEL=
