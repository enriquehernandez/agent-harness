# ==========================================
# CONFIGURACIÓN DEL LLM (Agent Harness)
# ==========================================
# Opciones soportadas por el Registry:  OPENAI, CLAUDE, GEMINI, GROQ, OPENROUTER, FAKE
LLM_PROVIDER=openrouter

# OpenRouter (Recomendado por su compatibilidad y soporte multimodal)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI (Directo)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Groq (Ultra rápido)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# CONFIGURACIÓN DE SEGURIDAD (Harness)
# ==========================================
# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==========================================
# CONFIGURACIÓN MCP (Opcional)
# ==========================================
# Si usas variables de entorno para servidores MCP externos, defínelas aquí.
# (La configuración principal de servidores está en mcp_config.json)

# ==========================================
# PROMPT CACHING
# ==========================================
# Activa el cacheo de prompts para ahorrar tokens (soportado en OpenAI y OpenRouter)
ENABLE_PROMPT_CACHING=true