# ==========================================
# Base de datos local y otros archivos temporales
# ==========================================
chroma_db/
*.sqlite3
*.log

# ==========================================
# Datos de usuario del Harness
# ==========================================
# Todo .harness/ queda fuera salvo la configuración y los scripts de hooks.
.harness/*
!.harness/hooks.json
!.harness/hooks/
.harness/hooks/*
!.harness/hooks/**
# Los logs y los bytecode generados por los hooks siguen siendo locales.
.harness/hooks/**/*.log
.harness/hooks/**/__pycache__/
.harness/hooks/**/*.pyc

