{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."]
    },
    "filesystem": {
      "command": "bash",
      "args": ["scripts/filesystem_mcp_wrapper.sh", "."]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "local_dev": {
      "command": "uv",
      "args": ["run", "python", "scripts/local_mcp_server.py"]
    }
  }
}
