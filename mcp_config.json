{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git==2026.11.27", "--repository", "."]
    },
    "filesystem": {
      "command": "bash",
      "args": ["scripts/filesystem_mcp_wrapper.sh", "."]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch==2026.11.27"]
    },
    "local_dev": {
      "command": "uv",
      "args": ["run", "python", "scripts/local_mcp_server.py"],
      "allowed_env": ["HARNESS_E2E"]
    }
  }
}
